PORT=4000
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:3000
# Change this in any non-local environment
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
# SQLite file location (sql.js, no native build required)
DB_PATH=data/expense-tracker.sqlite
# Seed a demo user with sample data on first start (true/false)
SEED_DEMO=true
